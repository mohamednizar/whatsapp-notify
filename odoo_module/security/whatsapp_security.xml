<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- WhatsApp Manager Group -->
        <record id="group_whatsapp_manager" model="res.groups">
            <field name="name">WhatsApp Manager</field>
            <field name="category_id" ref="base.module_category_tools"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Full access to WhatsApp configuration and messages</field>
        </record>
        
        <!-- WhatsApp User Group -->
        <record id="group_whatsapp_user" model="res.groups">
            <field name="name">WhatsApp User</field>
            <field name="category_id" ref="base.module_category_tools"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can send WhatsApp messages but cannot modify configuration</field>
        </record>
        
        <!-- Record Rules -->
        
        <!-- WhatsApp Config: Only managers can modify -->
        <record id="whatsapp_config_manager_rule" model="ir.rule">
            <field name="name">WhatsApp Config: Manager Access</field>
            <field name="model_id" ref="model_whatsapp_config"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_whatsapp_manager'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>
        
        <record id="whatsapp_config_user_rule" model="ir.rule">
            <field name="name">WhatsApp Config: User Read Only</field>
            <field name="model_id" ref="model_whatsapp_config"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>
        
        <!-- WhatsApp Templates: Managers can modify, users can read -->
        <record id="whatsapp_template_manager_rule" model="ir.rule">
            <field name="name">WhatsApp Template: Manager Access</field>
            <field name="model_id" ref="model_whatsapp_template"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_whatsapp_manager'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>
        
        <record id="whatsapp_template_user_rule" model="ir.rule">
            <field name="name">WhatsApp Template: User Read Only</field>
            <field name="model_id" ref="model_whatsapp_template"/>
            <field name="domain_force">[('active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>
        
    </data>
</odoo>