<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Send WhatsApp Template Wizard -->
        
        <!-- Form View -->
        <record id="view_whatsapp_send_template_wizard_form" model="ir.ui.view">
            <field name="name">whatsapp.send.template.wizard.form</field>
            <field name="model">whatsapp.send.template.wizard</field>
            <field name="arch" type="xml">
                <form string="Send WhatsApp Template">
                    <sheet>
                        <div class="oe_title">
                            <h1>Send WhatsApp Template</h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" options="{'no_create': True}"/>
                                <field name="phone_number"/>
                                <field name="template_id" options="{'no_create': True}"/>
                                <field name="config_id" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="send_immediately"/>
                            </group>
                        </group>
                        
                        <group string="Template Variables" attrs="{'invisible': [('template_id', '=', False)]}">
                            <field name="template_variables" widget="ace" options="{'mode': 'json'}" 
                                   placeholder='{"variable_name": "variable_value"}'/>
                        </group>
                        
                        <group string="Preview" attrs="{'invisible': [('preview_content', '=', False)]}">
                            <field name="preview_content" widget="text" readonly="1"/>
                        </group>
                        
                        <group string="Attachments (For receipts/ebooks)" attrs="{'invisible': [('template_id', '=', False)]}">
                            <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_preview_template" type="object" string="Preview" class="btn-secondary" 
                                attrs="{'invisible': [('template_id', '=', False)]}"/>
                        <button name="action_send_template" type="object" string="Send Template" class="btn-primary"/>
                        <button name="action_send_and_view_message" type="object" string="Send &amp; View" class="btn-secondary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        
        <!-- Action -->
        <record id="action_whatsapp_send_template_wizard" model="ir.actions.act_window">
            <field name="name">Send WhatsApp Template</field>
            <field name="res_model">whatsapp.send.template.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
    </data>
</odoo>