<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Extend Partner Form View -->
        
        <!-- Add WhatsApp functionality to partner form -->
        <record id="view_partner_whatsapp_form" model="ir.ui.view">
            <field name="name">res.partner.whatsapp.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                
                <!-- Add WhatsApp buttons to the header -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    
                    <!-- WhatsApp Messages Count Button -->
                    <button class="oe_stat_button" type="object" name="action_view_whatsapp_messages" icon="fa-whatsapp">
                        <field string="Messages" name="whatsapp_message_count" widget="statinfo"/>
                    </button>
                    
                </xpath>
                
                <!-- Add WhatsApp actions to the top buttons -->
                <xpath expr="//header" position="inside">
                    <button name="action_send_whatsapp_message" type="object" string="Send WhatsApp" 
                            class="btn-primary" attrs="{'invisible': [('mobile', '=', False)]}"/>
                    <button name="action_send_whatsapp_template" type="object" string="Send Template" 
                            class="btn-secondary" attrs="{'invisible': [('mobile', '=', False)]}"/>
                </xpath>
                
            </field>
        </record>
        
        <!-- Add WhatsApp tab to partner form (optional) -->
        <record id="view_partner_whatsapp_notebook" model="ir.ui.view">
            <field name="name">res.partner.whatsapp.notebook</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                
                <xpath expr="//notebook" position="inside">
                    <page string="WhatsApp Messages" attrs="{'invisible': [('whatsapp_message_count', '=', 0)]}">
                        <field name="whatsapp_message_ids" readonly="1">
                            <tree>
                                <field name="create_date"/>
                                <field name="subject"/>
                                <field name="message_type"/>
                                <field name="state"/>
                                <field name="sent_date"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
                
            </field>
        </record>
        
    </data>
</odoo>