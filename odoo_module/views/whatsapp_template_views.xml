<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- WhatsApp Template Views -->
        
        <!-- Tree View -->
        <record id="view_whatsapp_template_tree" model="ir.ui.view">
            <field name="name">whatsapp.template.tree</field>
            <field name="model">whatsapp.template</field>
            <field name="arch" type="xml">
                <tree string="WhatsApp Templates">
                    <field name="name"/>
                    <field name="title"/>
                    <field name="category"/>
                    <field name="active"/>
                    <field name="usage_count"/>
                </tree>
            </field>
        </record>
        
        <!-- Form View -->
        <record id="view_whatsapp_template_form" model="ir.ui.view">
            <field name="name">whatsapp.template.form</field>
            <field name="model">whatsapp.template</field>
            <field name="arch" type="xml">
                <form string="WhatsApp Template">
                    <header>
                        <button name="action_preview_template" type="object" string="Preview" class="btn-secondary"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="title"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="category"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="usage_count" readonly="1"/>
                            </group>
                        </group>
                        
                        <group>
                            <field name="description"/>
                        </group>
                        
                        <notebook>
                            <page string="Content">
                                <field name="content" widget="text" placeholder="Enter your template content here. Use {{variable_name}} for variables."/>
                            </page>
                            
                            <page string="Variables">
                                <field name="variables" widget="ace" options="{'mode': 'json'}" 
                                       placeholder='[{"name": "variable_name", "type": "text", "description": "Variable description", "required": true}]'/>
                                <div class="alert alert-info" role="alert">
                                    <p><strong>Variable Definition Format:</strong></p>
                                    <pre>[
  {
    "name": "variable_name",
    "type": "text|number|date|currency",
    "description": "Variable description",
    "required": true|false
  }
]</pre>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Search View -->
        <record id="view_whatsapp_template_search" model="ir.ui.view">
            <field name="name">whatsapp.template.search</field>
            <field name="model">whatsapp.template</field>
            <field name="arch" type="xml">
                <search string="WhatsApp Templates">
                    <field name="name"/>
                    <field name="title"/>
                    <field name="content"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter name="welcome" string="Welcome" domain="[('category', '=', 'welcome')]"/>
                    <filter name="notification" string="Notification" domain="[('category', '=', 'notification')]"/>
                    <filter name="receipt" string="Receipt" domain="[('category', '=', 'receipt')]"/>
                    <filter name="ebook" string="E-book" domain="[('category', '=', 'ebook')]"/>
                    <filter name="order" string="Order" domain="[('category', '=', 'order')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_category" string="Category" context="{'group_by': 'category'}"/>
                        <filter name="group_by_active" string="Active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Action -->
        <record id="action_whatsapp_template" model="ir.actions.act_window">
            <field name="name">WhatsApp Templates</field>
            <field name="res_model">whatsapp.template</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first WhatsApp template!
                </p>
                <p>
                    Templates help you send consistent, professional messages with variable content.
                </p>
            </field>
        </record>
        
    </data>
</odoo>