<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- POS Order Form View Enhancement -->
        <record id="view_pos_order_form_whatsapp" model="ir.ui.view">
            <field name="name">pos.order.form.whatsapp</field>
            <field name="model">pos.order</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_order_form"/>
            <field name="arch" type="xml">
                <!-- Add button after the form header -->
                <xpath expr="//form/header" position="after">
                    <div class="oe_button_box" name="button_box">
                        <!-- WhatsApp Send Receipt Button -->
                        <button name="action_send_whatsapp_receipt"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-whatsapp"
                                invisible="not can_send_whatsapp">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Send Receipt</span>
                                <span class="o_stat_text">via WhatsApp</span>
                            </div>
                        </button>
                        
                        <!-- WhatsApp Send E-books Button -->
                        <button name="action_send_whatsapp_ebooks"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="not can_send_whatsapp">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Send E-books</span>
                                <span class="o_stat_text">via WhatsApp</span>
                            </div>
                        </button>
                        
                        <!-- WhatsApp Messages Count -->
                        <button name="%(action_whatsapp_message)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-comments"
                                context="{'default_pos_order_id': active_id, 'search_default_pos_order_id': active_id}"
                                invisible="not whatsapp_message_ids">
                            <field name="whatsapp_message_ids" widget="statinfo" string="WhatsApp Messages"/>
                        </button>
                    </div>
                </xpath>
                
                <!-- Add WhatsApp fields to form -->
                <xpath expr="//field[@name='note']" position="after">
                    <!-- Add invisible field for button visibility -->
                    <field name="can_send_whatsapp" invisible="1"/>
                    <group string="WhatsApp Information" invisible="not whatsapp_message_ids">
                        <field name="whatsapp_sent" readonly="1"/>
                        <field name="whatsapp_message_ids" nolabel="1">
                            <tree>
                                <field name="create_date"/>
                                <field name="subject"/>
                                <field name="message_type"/>
                                <field name="state"/>
                                <field name="phone_number"/>
                            </tree>
                        </field>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- POS Order Tree View Enhancement -->
        <record id="view_pos_order_tree_whatsapp" model="ir.ui.view">
            <field name="name">pos.order.tree.whatsapp</field>
            <field name="model">pos.order</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='amount_total']" position="after">
                    <field name="whatsapp_sent" widget="boolean_toggle"/>
                </xpath>
            </field>
        </record>

        <!-- Add WhatsApp action to POS Order list -->
        <record id="action_pos_order_send_whatsapp" model="ir.actions.server">
            <field name="name">Send WhatsApp Receipt</field>
            <field name="model_id" ref="point_of_sale.model_pos_order"/>
            <field name="binding_model_id" ref="point_of_sale.model_pos_order"/>
            <field name="state">code</field>
            <field name="code">
                for record in records:
                    if record.partner_id and (record.partner_id.mobile or record.partner_id.phone):
                        record.action_send_whatsapp_receipt()
                    else:
                        raise UserError("Please ensure the order has a customer with a phone number.")
            </field>
        </record>

        <!-- Menu item for POS WhatsApp Configuration -->
        <menuitem id="menu_pos_whatsapp_config"
                  name="POS WhatsApp"
                  parent="point_of_sale.menu_point_config"
                  sequence="50"/>
                  
        <!-- POS Orders with WhatsApp filter -->
        <record id="action_pos_order_whatsapp" model="ir.actions.act_window">
            <field name="name">POS Orders (WhatsApp)</field>
            <field name="res_model">pos.order</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('whatsapp_message_ids', '!=', False)]</field>
            <field name="context">{'search_default_whatsapp_sent': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No POS orders with WhatsApp messages found.
                </p>
                <p>
                    Send receipts and e-books to customers via WhatsApp from POS orders.
                </p>
            </field>
        </record>

        <menuitem id="menu_pos_order_whatsapp"
                  name="Orders with WhatsApp"
                  parent="menu_pos_whatsapp_config"
                  action="action_pos_order_whatsapp"
                  sequence="10"/>

    </data>
</odoo>